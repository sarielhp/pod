  def build_summary(num, profile, model_step, findings, footprint: nil, diff_audit: nil)
    plan_file = Dir.glob("#{reports_dir}/#{num}*plan*.md").first
    report_file = Dir.glob("#{reports_dir}/#{num}_#{profile}.md").first ||
                  Dir.glob("#{reports_dir}/#{num}*.md").reject { |f| f =~ /plan|summary/ }.first

    issues = extract_issues_from_plan(plan_file)
    issues = extract_issues_from_report(report_file) if issues.empty?

    count = issues.any? ? issues.size : findings
    lines = [
      "# Review Cycle #{num} Summary (Lens: #{profile})",
      '',
      "- **Round**: #{num}",
      "- **Focus Lens**: `#{profile}`",
      "- **Auditor**: #{model_step[:label]}",
      "- **Issues Found**: #{count}",
      "- **Status**: Remediated & Verified"
    ]
    if footprint && footprint[:stat] && !footprint[:stat].empty?
      lines << "- **Footprint**: #{footprint[:stat]}"
    end
    if diff_audit
      audit_label = diff_audit[:findings].zero? ? 'Clean (0 defects in diff)' : "#{diff_audit[:findings]} warning(s)"
      lines << "- **Differential Audit**: #{audit_label}"
    end
    lines << ''
    lines << '## Issues & Mitigations'
    lines << ''

    if issues.empty?
      lines << "1. **Issue**: #{count} defect(s) identified during audit."
      lines << '   - **Mitigation**: All identified defects resolved and verified via quality gate.'
    else
      issues.each_with_index do |it, i|
        loc_part = it[:loc] ? " (`#{it[:loc]}`)" : ''
        lines << "#{i + 1}. **Issue**: #{it[:desc]}#{loc_part}"
        lines << "   - **Mitigation**: #{it[:rem]}"
      end
    end

    lines.join("\n") + "\n"
  end

  def extract_issues_from_plan(plan_file)
    return [] unless plan_file && File.exist?(plan_file)

    content = File.read(plan_file)
    items = extract_table_issues(content)
    return items unless items.empty?

    extract_section_issues(content)
  end

  def extract_table_issues(content)
    table_lines = content.lines.select { |l| l.strip.start_with?('|') }
    return [] if table_lines.size < 3

    header = table_lines[0].split('|').map(&:strip).reject(&:empty?)
    issue_col = header.index { |h| h =~ /issue\s*(summary|name|desc)|defect\s*classification/i }
    rem_col = header.index { |h| h =~ /target\s*resolution|remediated\s*by|fix|resolution/i }
    loc_col = header.index { |h| h =~ /component|subsystems?|location|target/i }
    return [] unless issue_col && rem_col

    items = []
    table_lines[2..].each do |row|
      cols = row.split('|').map(&:strip).reject(&:empty?)
      next if cols.empty? || cols.all? { |c| c =~ /^[ \-:]+$/ }

      desc = cols[issue_col]
      rem = cols[rem_col]
      loc = loc_col ? cols[loc_col] : nil
      if desc && rem
        items << {
          desc: desc.gsub(/[`*]/, '').strip,
          rem: rem.gsub(/[`*]/, '').strip,
          loc: loc&.gsub(/[`*]/, '')&.strip
        }
      end
    end
    items
  end

  def extract_section_issues(content)
    items = []
    content.scan(/###\s+(?:Issue\s*\d*[:.]?\s*)?([^\n]+)(.*?)(?=###|\Z)/m).each do |title, body|
      desc = title.strip.gsub(/[`*]/, '')
      fix = body[/(?:-\s*\*\*Fix\*\*|\*\*Resolution\*\*|Remediation)[:\s]*([^\n]+)/i, 1]
      items << { desc: desc, rem: fix.strip.gsub(/[`*]/, '') } if fix
    end
    items
  end

  def extract_issues_from_report(report_file)
    return [] unless report_file && File.exist?(report_file)

    content = File.read(report_file)
    blocks = content.split(/\[SEVERITY\]:/i)[1..] || []
    return extract_severity_blocks(blocks) if blocks.any?

    extract_markdown_heading_issues(content)
  end

  def extract_severity_blocks(blocks)
    blocks.map do |block|
      loc = block[/\[LOCATION\]:\s*(.+)/i, 1]&.strip&.gsub(/[`*]/, '')
      root_cause = block[/\[ROOT CAUSE\]:\s*(.+?)(?=\n\s*\[|\Z)/im, 1]&.strip
      desc = clean_first_sentence(root_cause) || "Issue detected in #{loc || 'codebase'}"
      desc = desc[0..130] + '...' if desc.length > 133

      remediation = block[/\[REMEDIATION\]:\s*(.+?)(?=\n\s*---|\Z)/im, 1]&.strip
      rem = clean_remediation_line(remediation)
      rem = rem[0..130] + '...' if rem.length > 133

      { desc: desc, rem: rem, loc: loc }
    end
  end

  def clean_first_sentence(text)
    return nil unless text

    first_line = text.lines.first.strip
    combined = if first_line.length < 35 && text.lines[1]
                 first_line + ' ' + text.lines[1].strip
               else
                 first_line
               end
    combined.gsub(/[`*]/, '').sub(/\A[^a-zA-Z0-9]+/, '').strip
  end

  def clean_remediation_line(remediation)
    return 'Remediated' unless remediation

    outside_code = remediation.gsub(/```[a-zA-Z0-9_-]*\n.*?```/m, '').strip
    prose = outside_code.lines.map(&:strip).reject(&:empty?).reject { |l| l =~ /^[>\-*#]/ }.first
    if prose && prose.length > 5
      return prose.sub(/^\((.+)\)$/, '\1').gsub(/[`*]/, '').sub(/\A[^a-zA-Z0-9]+/, '').strip
    end

    comment = remediation.scan(/(?<!:)\/\/\s*([^\n]+)/).flatten.reject { |c| c =~ /resolve\(\)/ }.first
    return comment.gsub(/[`*]/, '').strip if comment && comment.length > 5

    code_line = remediation.lines.reject { |l| l.strip.empty? || l.strip.start_with?('```') }.first&.strip
    code_line ? "Code fix: `#{code_line[0..60]}`" : 'Resolved in code'
  end

  def extract_markdown_heading_issues(content)
    items = []
    content.scan(/###\s+\d+\.\s*\[(?:CRITICAL|MAJOR|MODERATE)\]\s*([^\n]+)(.*?)(?=###|\Z)/m).each do |title, body|
      desc = title.strip.gsub(/[`*]/, '')
      rem = body[/(?:-\s*\*\*Remediation\*\*|Remediation)[:\s]*([^\n]+)/i, 1]
      clean_rem = rem ? rem.strip.gsub(/[`*]/, '') : 'Remediated'
      clean_rem = clean_rem[0..130] + '...' if clean_rem.length > 133
      items << { desc: desc, rem: clean_rem }
    end
    items
  end

  def archive_artifacts(num)
