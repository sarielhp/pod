  def remediate_in_sandbox(num, profile)
    branch = "fix-review-#{num}-#{profile}-remediation"
    gate_note = resolve_gate_cmd ? " and verify with #{resolve_gate_cmd}" : ''
    guide_note = guideline_instructions
    plan_path = "#{reports_dir}/#{num}_#{profile}_plan.md"
    report_path = "#{reports_dir}/#{num}_#{profile}.md"
    summary_path = "#{reports_dir}/#{num}_summary.md"

    prompt = "/goal Create a detailed architectural plan in #{plan_path} to address every bug in #{report_path}, and then implement fixes for all issues across the codebase until fully resolved. Focus area: #{profile} audit. INVARIANT: For each defect remediated, you MUST add or update at least one regression unit test validating the fix. Keep changes scoped strictly to the reported issues.#{guide_note}#{gate_note}. Also write a post-work summary to #{summary_path} that very briefly summarizes the round (how many issues found), and for each issue provides a 1-line description of the issue and a 1-line summary of how it was mitigated. Save plan to #{plan_path}, save summary to #{summary_path}, and commit all work when complete."

    msg = "\n==> [Phase 2/5] Dispatching Sandbox Agent via bws gw on branch #{branch}..."
    puts msg.bold.cyan
    log_write("#{msg}\n")

    cmd = [
      'bws', 'gw', '--allow-dirty', '-b', branch, '--',
      'agy-run-wild', '--effort', options[:effort],
      '-p', prompt
    ]

    success = run_with_auto_triage(cmd)
    unless success
      err_msg = "❌ Sandbox execution failed or was discarded. Full log: #{@current_log_path}"
      puts err_msg.bold.red
      log_write("#{err_msg}\n")
    end
    success
  end

  def run_with_auto_triage(cmd_args)
    command_str = cmd_args.map { |a| a.include?(' ') ? %("#{a.gsub('"', '\"')}") : a }.join(' ')
    buffer = String.new
    prompt_responded = false
    status = nil

    log_write("--> Spawning PTY: #{command_str}\n")
    PTY.spawn(command_str) do |stdout, stdin, pid|
      begin
        while (char = stdout.getc)
          print char
          $stdout.flush
          log_write(char)
          buffer << char
          buffer = buffer[-300..] if buffer.length > 600

          if !prompt_responded && buffer.include?('What would you like to do with branch')
            auto_msg = "\n[tools/review_cycle] Auto-selecting [s] Squash-merge...\n"
            puts auto_msg.bold.green
            log_write(auto_msg)
            stdin.write("s\n")
            stdin.flush
            prompt_responded = true
          end
        end
      rescue Errno::EIO
        # Normal process completion
      rescue Interrupt, SignalException => e
        Process.kill('TERM', pid) rescue nil
        sleep 0.2
        Process.kill('KILL', pid) rescue nil
        raise e
      ensure
        _, status = Process.wait2(pid) rescue [nil, nil]
      end
    end

    exit_code = status&.exitstatus || (status&.success? ? 0 : 1)
    log_write("--> Sandbox PTY exited with status: #{exit_code}\n")
    status&.success? || false
  end

  def check_diff_footprint(base_sha)
    stat_str = `git diff --shortstat #{base_sha}..HEAD`.strip
    file_list = `git diff --name-only #{base_sha}..HEAD`.lines.map(&:strip).reject(&:empty?)

    puts "\n==> Inspecting Remediation Footprint...".cyan
    puts "  Files modified: #{file_list.size} file(s)"
    puts "  Diff stat: #{stat_str.empty? ? 'No changes' : stat_str}"

    test_files = file_list.select { |f| f =~ /test/i || f.start_with?('tests/') || f.end_with?('_test.go') }
    if test_files.any?
      puts "  ✓ Regression test(s) modified/added: #{test_files.join(', ')}".green
    else
      warn '  ⚠️ Warning: No regression test files modified in this cycle.'.yellow
    end

    insertions = stat_str[/(\d+)\s+insertion/, 1].to_i
    deletions = stat_str[/(\d+)\s+deletion/, 1].to_i
    total_lines = insertions + deletions

    max_lines = options[:max_diff_lines] || 800
    if total_lines > max_lines
      msg = "Diff footprint (#{total_lines} lines) exceeds threshold (#{max_lines} lines)"
      if options[:strict_diff]
        return { aborted: true, reason: msg }
      else
        warn "  ⚠️ Warning: #{msg}.".yellow
      end
    end

    { aborted: false, files: file_list, total_lines: total_lines, test_files: test_files, stat: stat_str }
  end

  def run_differential_audit(profile, base_sha)
    diff = `git diff #{base_sha}..HEAD`
    return { findings: 0, output: 'No code changes in diff' } if diff.strip.empty?

    puts "\n==> Running Differential Audit on Remediation Diff [Lens: #{profile}]...".bold.cyan
    audit_bin = resolve_audit_executable
    return nil unless audit_bin

    cmd = audit_bin.split + ['-p', profile, '-t', 'tier0', '-b', 'gemini']
    output = String.new

    Open3.popen2e(*cmd) do |stdin, stdout_err, wait_thr|
      stdin.write(diff)
      stdin.close rescue nil
      while (line = stdout_err.gets)
        output << line
      end
      wait_thr.value
    end

    findings = output.scan(/\[SEVERITY\]/i).size
    if findings.zero?
      puts '  ✓ Differential audit passed: 0 defects detected in remediation diff.'.bold.green
    else
      warn "  ⚠️ Differential audit flagged #{findings} potential defect(s) in remediation diff:".yellow
      output.scan(/\[SEVERITY\]:\s*([^\n]+).*?\[LOCATION\]:\s*([^\n]+)/m).each do |sev, loc|
        warn "    - [#{sev.strip}] #{loc.strip}".yellow
      end
    end

    { findings: findings, output: output }
  rescue StandardError => e
    warn "  ⚠️ Differential audit error: #{e.message}".yellow
    nil
  end

