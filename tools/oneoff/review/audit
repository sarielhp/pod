def detect_project_language(dir = Dir.pwd)
  if File.exist?(File.join(dir, 'go.mod'))
    :go
  elsif File.exist?(File.join(dir, 'Cargo.toml'))
    :rust
  elsif Dir.glob(File.join(dir, '**', '*.go')).any?
    :go
  elsif Dir.glob(File.join(dir, '**', '*.rs')).any?
    :rust
  else
    :generic
  end
end

