#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'digest'

def install_verified_binary(source, install_dir)
  target_binary = File.join(install_dir, 'pod')
  expected_digest = Digest::SHA256.file(source).hexdigest
  abort 'Cannot create installation directory.' unless system('install', '-d', install_dir)
  abort 'Cannot install pod.' unless system('install', '-m', '755', source, target_binary)
  installed_digest = Digest::SHA256.file(target_binary).hexdigest
  abort 'Installation verification failed: installed binary differs from the build.' unless installed_digest == expected_digest
  FileUtils.rm_f(File.join(install_dir, 'abs'))
  puts "Installed and verified #{target_binary}"
end

if __FILE__ == $PROGRAM_NAME
  root_dir = File.expand_path('..', __dir__)
  Dir.chdir(root_dir)
  abort 'Build failed; installation stopped.' unless system('./tools/build')
  install_verified_binary('pod', File.expand_path('~/bin'))
end
