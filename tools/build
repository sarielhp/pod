#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "fileutils"

root_dir = File.expand_path("..", __dir__)
Dir.chdir(root_dir)

target_binary = File.join(root_dir, "pod")
legacy_binary = File.join(root_dir, "abs")

# Build exclusively into the local repository root
stdout, stderr, status = Open3.capture3('go', 'build', '-o', target_binary, '.')

unless status.success?
  warn "\e[31m✗ Local build failed!\e[0m"
  warn stdout unless stdout.empty?
  warn stderr unless stderr.empty?
  exit 1
end

# Verify output is strictly within local repository directory
resolved_path = (File.exist?(target_binary) ? File.realpath(target_binary) : target_binary)
unless resolved_path.start_with?(root_dir)
  warn "\e[31m✗ Security violation: binary target #{resolved_path} is outside #{root_dir}!\e[0m"
  exit 1
end

begin
  File.chmod(0755, target_binary)
  FileUtils.rm_f(legacy_binary)
rescue Errno::EROFS, Errno::EPERM
  # Ignored in read-only / restricted sandbox
end
puts "Built ./pod successfully."
