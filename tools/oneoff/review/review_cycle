    files = (Dir.glob("#{reports_dir}/#{num}*.md") + Dir.glob("#{num}*.md")).uniq
    return if files.empty?

    files.each do |file|
      dest = File.join(arch_path, File.basename(file))
      if system('git', 'ls-files', '--error-unmatch', file, out: File::NULL, err: File::NULL)
        system('git', 'mv', file, dest)
      else
        FileUtils.mv(file, dest)
      end
      puts "  Archived: #{file} -> #{dest}".cyan
    end

    system('git', 'add', arch_path, reports_dir)
    system('git', 'commit', '-m', "docs: archive review #{num} artifacts (report, plan, summary) in #{arch_path}/")
    puts "Review #{num} artifacts safely archived in #{arch_path}/.".green
