    when 'clean'           then 'Clean (Zero Defects Detected)'.bold.green
    when 'failed_sandbox'  then 'Remediation Failed in Sandbox (Rolled Back)'.bold.red
    when 'failed_gate'     then 'Quality Gate Failed Post-Merge (Rolled Back)'.bold.red
    when 'rejected_diff'   then 'Diff Footprint Exceeded (Rolled Back)'.bold.red
    when 'dry_run'         then 'Dry Run (No Changes Applied)'.bold.yellow
    else outcome.to_s.capitalize.yellow
    end
  end

