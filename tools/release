#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'

install = false
parser = OptionParser.new do |options|
  options.banner = 'Usage: tools/release [--install] <commit-message>'
  options.on('--install', 'Install after the verified push') { install = true }
  options.on('-h', '--help', 'Show usage') do
    puts options
    exit
  end
end
begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n#{parser}"
end
message = ARGV.join(' ').strip
abort parser.to_s if message.empty?

Dir.chdir(File.expand_path('..', __dir__))
abort 'Release stopped at commit.' unless system('./tools/commit', message)
abort 'Release stopped at bump/push. Inspect local state before retrying; do not repeat the bump.' unless system('./tools/bump')
abort 'Release pushed, but installation failed.' if install && !system('./tools/install')
version = File.read('VERSION').strip
result = "Released #{version}"
result += ' and installed' if install
puts result
