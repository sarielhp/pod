#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'fileutils'

root_dir = File.expand_path('..', __dir__)
Dir.chdir(root_dir)

if ARGV.empty?
  puts "Usage: #{$PROGRAM_NAME} <commit-message>"
  exit 1
end

msg = ARGV.join(' ')

# Remove any stale verified head before running checks
FileUtils.rm_f('.verified_head')

# Run quality gate silently
_, _, status = Open3.capture3('./tools/check')
unless status.success?
  puts "✗ Quality Gate failed! Run 'make check' to see details."
  exit 1
end

# Commit
_, stderr, add_status = Open3.capture3('git', 'add', '-A')
unless add_status.success?
  warn stderr unless stderr.empty?
  abort 'Git staging failed; commit stopped.'
end
_, stderr, commit_status = Open3.capture3('git', 'commit', '-m', msg)
unless commit_status.success?
  puts '✗ Git commit failed!'
  warn stderr unless stderr.empty?
  exit 1
end

# Record the committed HEAD SHA into .verified_head
head_sha, _, sha_status = Open3.capture3('git', 'rev-parse', 'HEAD')
File.write('.verified_head', "#{head_sha.strip}\n") if sha_status.success?

puts "Success #{msg}"
