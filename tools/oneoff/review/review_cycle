    extra = []
    if footprint && footprint[:stat] && !footprint[:stat].empty? && !content.include?('**Footprint**')
      extra << "- **Footprint**: #{footprint[:stat]}\n"
    end
    if diff_audit && !content.include?('**Differential Audit**')
      label = diff_audit[:findings].zero? ? 'Clean (0 defects in diff)' : "#{diff_audit[:findings]} warning(s)"
      extra << "- **Differential Audit**: #{label}\n"
    end

    lines.insert(meta_idx + 1, *extra).join
  end

