  def extract_severity_breakdown(review_content)
    counts = { 'severe' => 0, 'major' => 0, 'medium' => 0, 'minor' => 0, 'other' => 0 }
    return counts if review_content.nil? || review_content.empty?

    found = 0
    review_content.scan(/\[SEVERITY\]:?\s*([a-zA-Z]+)/i).each do |(level)|
      found += 1
      categorize_severity(level, counts)
    end

    if found.zero?
      heading_regex = /###\s+\d+\.\s*\[(CRITICAL|MAJOR|MODERATE|SEVERE|HIGH|MEDIUM|LOW|MINOR)\]/i
      review_content.scan(heading_regex).each do |(level)|
        found += 1
        categorize_severity(level, counts)
      end
    end

    counts
  end

  def categorize_severity(level, counts)
    case level.downcase
    when /crit|sever|block/ then counts['severe'] += 1
    when /maj|high/        then counts['major'] += 1
    when /mod|med/         then counts['medium'] += 1
    when /min|low|info/    then counts['minor'] += 1
    else counts['other'] += 1
    end
  end

  def colorize_severity_count(count, level_type)
    return '0'.green if count.zero?

    case level_type
    when :severe then count.to_s.bold.red
    when :major  then count.to_s.bold.yellow
    when :medium then count.to_s.bold.cyan
    when :minor  then count.to_s.bold.blue
    else count.to_s
    end
  end

  def format_status_label(outcome)
